:root {
    --fundo: #080820;
    --lateral: #11112b;
    --card: #1a1542;
    --painel: #231e5c;
    --linha: #4a46d6;
    --linha-lateral: #26225f;
    --titulo: #4f46e5;
    --roxo: #5b14f0;
    --texto: #ffffff;
    --vermelho: #ff3333;
    --cinza: #c8d0dc;
    --barra: #4a46d6;
}



* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}


/* O corpo */
body {
    font-family: "Lexend", system-ui, sans-serif;

    background: var(--fundo);

    color: var(--texto);

    min-height: 100vh;

    display: grid;

    grid-template-columns: 220px 1fr;
}


/* Os elementos gerais */

a {
    color: inherit;
    text-decoration: none;
}

ul {
    list-style: none;
}

/* A barra do lado */

.sidebar {
    background: var(--lateral);

    border-right: 6px solid var(--linha-lateral);

    padding: 20px 14px;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 48px;

    position: sticky;

    top: 0;

    height: 100vh;
}


/* Logo */

.logo {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 8px;

    width: 100%;

    padding-bottom: 14px;

    border-bottom: 4px solid var(--linha);
}

.logo-icone {
    width: 90px;
    height: 90px;

    object-fit: contain;
}

.logo-escrita {
    height: 34px;

    width: auto;
}


/* Menu, fiz uma animação basica so para ver como fica */



.sidebar nav {
    width: 100%;
}

.sidebar ul {
    display: flex;
    flex-direction: column;

   
    gap: 56px;
}

.sidebar li a {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    padding-bottom: 10px;


    border-bottom: 4px solid var(--linha-lateral);

    font-size: 0.85rem;
    font-weight: 500;
    text-align: center;

    transition:
        color 0.25s ease,
        transform 0.25s ease;
}


.sidebar li a::after {
    content: "";

    position: absolute;
    left: 50%;
    bottom: -4px;

    width: 0;
    height: 4px;

    background: var(--roxo);

    transform: translateX(-50%);

    transition: width 0.3s ease;
}

.sidebar li a:hover {
    color: var(--texto);

    
    transform: translateY(-3px);
}

.sidebar li a:hover::after {
    width: 100%;
}

.sidebar li a:active {
    transform: translateY(0) scale(0.97);
}


.sidebar li a:focus-visible {
    outline: 2px solid var(--roxo);
    outline-offset: 6px;
    border-radius: 4px;
}

/* Ícones */

.icone {
    width: 20px;

    height: 20px;

    flex-shrink: 0;
}

.icone:empty {
    display: none;
}